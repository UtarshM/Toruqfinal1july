{
  "expo": {
    "name": "Torque Auto Advisor",
    "slug": "torque-auto-advisor",
    "version": "2.0.0",
    "orientation": "portrait",
    "updates": {
      "url": "https://u.expo.dev/08940434-daad-4f58-9bf2-779b2b79cdba"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "torque-auto-advisor",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.torqueautoadvisor.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#002FA7"
      },
      "package": "com.torqueautoadvisor.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#002FA7"
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload onboarding documents and photos.",
          "cameraPermission": "The app accesses your camera to let you take onboarding photos.",
          "colors": {
            "cropToolbarColor": "#002FA7"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#002FA7"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08940434-daad-4f58-9bf2-779b2b79cdba"
      }
    },
    "owner": "jiya1218"
  }
}
